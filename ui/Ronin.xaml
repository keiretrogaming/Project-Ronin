<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PROJECT RONIN // Definitive Edition (v8.0.0)" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="Transparent" Foreground="#E6EAEE" FontFamily="Segoe UI Variable Text, Segoe UI"
        MinWidth="800" MinHeight="450" WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <!-- 8.0 BLACK ICE. Every font here ships with Windows 11 (Cascadia Mono, Bahnschrift, Segoe UI Variable),
             with Consolas / Segoe UI as fallbacks: nothing is bundled. Height went 730 -> 760 for the status bar,
             so no tab is drawn smaller than in 7.6. -->
        <SolidColorBrush x:Key="Accent" Color="#FF2E3A"/>
        <SolidColorBrush x:Key="Amber" Color="#F2A93B"/>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="Cond">Bahnschrift, Segoe UI</FontFamily>
        <LinearGradientBrush x:Key="OnFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#14FF2E3A" Offset="0"/><GradientStop Color="#A0FF2E3A" Offset="1"/>
        </LinearGradientBrush>
        <!-- queued (changed here, not applied yet): amber hazard stripes -->
        <LinearGradientBrush x:Key="HazardAmber" MappingMode="Absolute" StartPoint="0,0" EndPoint="4,4" SpreadMethod="Repeat">
            <GradientStop Color="#66F2A93B" Offset="0"/><GradientStop Color="#66F2A93B" Offset="0.5"/>
            <GradientStop Color="#00F2A93B" Offset="0.5"/><GradientStop Color="#00F2A93B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HazardInk" MappingMode="Absolute" StartPoint="0,0" EndPoint="5,5" SpreadMethod="Repeat">
            <GradientStop Color="#12030A" Offset="0"/><GradientStop Color="#12030A" Offset="0.5"/>
            <GradientStop Color="#0012030A" Offset="0.5"/><GradientStop Color="#0012030A" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cards: dark gradient, hairline border lit red at two corners (top-left, bottom-right). -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F7111318" Offset="0"/><GradientStop Color="#F70A0B0E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D0FF2E3A" Offset="0"/><GradientStop Color="#1D2128" Offset="0.07"/>
                        <GradientStop Color="#1D2128" Offset="0.93"/><GradientStop Color="#D0FF2E3A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="2" Background="#0B0D11" BorderBrush="#2A3038" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8A939E" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#FF2E3A"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FF2E3A"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="Background" Value="#0B0D11"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,23,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,3,23,3" Focusable="True" Background="Transparent" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0B0D11" BorderThickness="1" BorderBrush="#FF2E3A"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#C9D0D7"/>
            <Setter Property="Background" Value="#0B0D11"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A0B0F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A0E13"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tweak switch. ON = red glow; Tag "Q" = changed here but not applied yet (amber hazard stripes,
             the thumb already where Apply will put it). Label colour follows the switch, so code must not set
             a tweak checkbox's Foreground (a local value would override these triggers). -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#9AA3AD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2"/> <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Track" Grid.Column="0" Width="30" Height="14" CornerRadius="2" Background="#090B0E" BorderBrush="#2E343C" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="Fill" Background="{StaticResource OnFill}" Visibility="Collapsed"/>
                                    <Rectangle x:Name="Thumb" Width="5" Height="8" RadiusX="1" RadiusY="1" Fill="#4A525C" HorizontalAlignment="Left" Margin="2,0"/>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="ContentText" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF2E3A"/>
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFF4F4"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#FF2E3A" Opacity="0.4"/></Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#E6EAEE"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Q">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#F2A93B"/>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource HazardAmber}"/>
                                <Setter TargetName="Fill" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFD089"/>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#F2A93B" Opacity="0.35"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentText" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.3"/>
                                <Setter Property="Foreground" Value="#4A525C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav. TabIndex doubles as the 01-08 index; Update-TabUI shows ActiveBg/AccentBar on the
             current tab and writes the per-tab "on/total" count into Count. -->
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A939E"/>
            <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid x:Name="ActiveBg" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4DFF2E3A" Offset="0"/><GradientStop Color="#12FF2E3A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Path Grid.Column="1" Stretch="Fill" Fill="#12FF2E3A" Data="M0,0 L12,17 L0,34 Z"/>
                            </Grid>
                            <Rectangle x:Name="AccentBar" HorizontalAlignment="Left" Width="2" Fill="#FF2E3A" Visibility="Collapsed">
                                <Rectangle.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="10" ShadowDepth="0"/></Rectangle.Effect>
                            </Rectangle>
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <TextBlock x:Name="Idx" Text="{Binding TabIndex, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:00}}" FontFamily="{StaticResource Mono}" FontSize="9.5" Width="20" Foreground="#5C6570" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,1,11,0" Width="18" TextAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="Count" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="#7D8692"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowControlBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A939E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline button (secondary actions). -->
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="Background" Value="#0B0D11"/>
            <Setter Property="Foreground" Value="#C9D0D7"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="#FF2E3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bdr" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply buttons: angled red slab. Code shows "Hazard" (black stripes) while the tab has queued
             changes; Background still follows the button (Firebrick while a preview waits for its confirm). -->
        <Style TargetType="Button" x:Key="ApplyBtn">
            <Setter Property="Background" Value="#FF2E3A"/>
            <Setter Property="Foreground" Value="#12030A"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Grid.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="#FF2E3A" Opacity="0.35"/></Grid.Effect>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/></Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{TemplateBinding Background}"/>
                            <Path Grid.Column="1" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M0,0 L11,0 L11,33 L0,44 Z"/>
                            <Rectangle x:Name="Hazard" Grid.Column="0" Width="18" HorizontalAlignment="Left" Fill="{StaticResource HazardInk}" Visibility="Collapsed"/>
                            <ContentPresenter Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 8.0: compact launcher buttons (Declutter > Windows Tools). Tag = the command to run. -->
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Background" Value="#0E1015"/>
            <Setter Property="Foreground" Value="#BBC2C9"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{TemplateBinding Background}" BorderBrush="#262B33" BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="#FF2E3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section heading: red angled chip, title, hairline. A ContentControl (not a TextBlock) so it can draw
             the chip; Foreground still tints the title where a section sets it. -->
        <Style TargetType="ContentControl" x:Key="H1">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#E6EAEE"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="24" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="M0,0 L24,0 L18,15 L0,15 Z" Fill="#FF2E3A"/>
                                <TextBlock Text="//" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="#12030A" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#1F242B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="AppHeader">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="KpiLabel">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="#7D8692"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="KpiValue">
            <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="#7D8692"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StatusText">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#7D8692"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- No stock Windows chrome. A button without a style of its own (Maintenance, DNS, Debloat / Startup / Install
             Apps, banner and Settings buttons, the Changes list's UNDO) used Windows' template: hovering one turned it
             light blue under white text. Each keeps its own Background / Foreground / BorderBrush; hover = red edge + lift. -->
        <Style TargetType="Button">
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True"/>
                            <Border x:Name="Lift" Background="#14FFFFFF" CornerRadius="2" Visibility="Collapsed"/>
                            <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="#FF2E3A"/>
                                <Setter TargetName="Lift" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lift" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bdr" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Cp" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips: dark, wrapped, instead of Windows' light grey box over a black UI. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#D5DBE1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F70B0D11" BorderBrush="#5A1C22" BorderThickness="1" CornerRadius="2" Padding="9,6">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog lists (Install Apps has 40+ apps): a thin dark scrollbar instead of Windows' light grey one.
             Keyed, so the main window (whose scroll areas hide their bars) is untouched; Set-DialogLook makes it
             the dialogs' implicit ScrollBar style. Vertical only - no dialog scrolls sideways. -->
        <Style x:Key="DlgScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#0F1216" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="#2E343C" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#FF2E3A"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#FF2E3A"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame" CornerRadius="8" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF2E3A" Offset="0"/><GradientStop Color="#262B33" Offset="0.12"/>
                <GradientStop Color="#262B33" Offset="0.88"/><GradientStop Color="#99FF2E3A" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <!-- faint dot grid -->
            <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#F806070A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                        <GeometryDrawing Brush="#14FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/> <RowDefinition Height="*"/> <RowDefinition Height="26"/> </Grid.RowDefinitions>

            <!-- TITLE BAR (drag area): brand | search | engine state + window buttons -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="#E6050608">
                <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FF2E3A" Offset="0"/><GradientStop Color="#C0FF2E3A" Offset="0.18"/>
                            <GradientStop Color="#C0FF2E3A" Offset="0.4"/><GradientStop Color="#00FF2E3A" Offset="0.75"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                    <Rectangle Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,11,0" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                        <Rectangle.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                    </Rectangle>
                    <TextBlock Text="PROJECT RONIN" Style="{StaticResource StatusText}" Foreground="#8A939E"/>
                    <TextBlock Text=" // " Style="{StaticResource StatusText}" Foreground="#4A525C"/>
                    <TextBlock Text="v8.0.0" Style="{StaticResource StatusText}" Foreground="#C9D0D7"/>
                </StackPanel>
                <Border Grid.Column="1" MaxWidth="380" Height="24" HorizontalAlignment="Stretch" Margin="0,0,14,0" Background="#0B0D11" BorderBrush="#1E232A" BorderThickness="1" CornerRadius="3" ToolTip="Search every tab (Ctrl+K)">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#x203A;" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}" FontSize="14" Margin="9,0,4,2" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="search tweaks..." Foreground="#5C6570" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" CaretBrush="#FF2E3A" FontFamily="{StaticResource Mono}" FontSize="11"/>
                        <Border Grid.Column="2" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="2" Padding="5,0" Margin="4,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="CTRL K" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot_Engine" Width="6" Height="6" Fill="#5BD68A" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Effect><DropShadowEffect Color="#5BD68A" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="Txt_EngineState" Text="ENGINE ONLINE" Style="{StaticResource StatusText}" Foreground="#7FD9A0" Margin="0,0,12,0"/>
                    <Button x:Name="Btn_RestartExp" Content="RESTART EXPLORER" Style="{StaticResource GhostBtn}" Height="22" FontSize="9.5" Padding="8,0" Margin="0,0,6,0" ToolTip="Restart Windows Explorer now (taskbar, Start, File Explorer) so shell changes show."/>
                    <Button x:Name="Btn_Settings" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WindowControlBtn}" ToolTip="Settings"/>
                    <Button x:Name="Btn_Min" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WindowControlBtn}"/>
                    <Button x:Name="Btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WindowControlBtn}">
                        <Button.Triggers>
                             <EventTrigger RoutedEvent="MouseEnter">
                                 <BeginStoryboard>
                                     <Storyboard>
                                         <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#C42B1C" Duration="0:0:0.1"/>
                                         <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="White" Duration="0:0:0.1"/>
                                     </Storyboard>
                                 </BeginStoryboard>
                             </EventTrigger>
                             <EventTrigger RoutedEvent="MouseLeave">
                                 <BeginStoryboard>
                                     <Storyboard>
                                         <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.2"/>
                                         <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="#8A939E" Duration="0:0:0.2"/>
                                     </Storyboard>
                                 </BeginStoryboard>
                             </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#161A20" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F70B0C10" Offset="0"/><GradientStop Color="#F707080B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid Width="236">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

                            <!-- LOGO: RONIN cut by a katana stroke (two clipped copies, the lower half nudged) -->
                            <StackPanel Grid.Row="0" Margin="18,16,14,0">
                                <TextBlock Text="P R O J E C T" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="#7D8692"/>
                                <Grid Width="200" Height="50" HorizontalAlignment="Left" Margin="-2,2,0,0" IsHitTestVisible="False">
                                    <TextBlock Text="RONIN" FontFamily="{StaticResource Cond}" FontStretch="Condensed" FontWeight="Bold" FontSize="56" Foreground="{StaticResource Accent}" Margin="0,-12,0,0">
                                        <TextBlock.Clip><PathGeometry Figures="M-20,-20 L220,-20 L220,20 L-20,34 Z"/></TextBlock.Clip>
                                        <TextBlock.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="RONIN" FontFamily="{StaticResource Cond}" FontStretch="Condensed" FontWeight="Bold" FontSize="56" Foreground="{StaticResource Accent}" Margin="0,-12,0,0">
                                        <TextBlock.Clip><PathGeometry Figures="M-20,34 L220,20 L220,120 L-20,120 Z"/></TextBlock.Clip>
                                        <TextBlock.RenderTransform><TranslateTransform X="4" Y="2"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
                                    </TextBlock>
                                    <Rectangle Width="196" Height="1.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,21,0,0">
                                        <Rectangle.RenderTransform><RotateTransform Angle="-3.3"/></Rectangle.RenderTransform>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.12"/>
                                                <GradientStop Color="#FFFF2E3A" Offset="0.45"/><GradientStop Color="#00FF2E3A" Offset="0.85"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="8" ShadowDepth="0" Opacity="1"/></Rectangle.Effect>
                                    </Rectangle>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="DEFINITIVE EDITION" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource Accent}" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="v8.0.0" FontFamily="{StaticResource Mono}" FontSize="9" FontWeight="Bold" Foreground="#12030A"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,14,8,0">
                                <Button x:Name="Nav_Auto" TabIndex="1" Content="AUTO OPTIMIZE" Style="{StaticResource NavBtn}" Tag="&#xE80F;" ToolTip="Quickly apply recommended profiles."/>
                                <Button x:Name="Nav_System" TabIndex="2" Content="SYSTEM CORE" Style="{StaticResource NavBtn}" Tag="&#xE770;" ToolTip="Essential Windows configurations."/>
                                <Button x:Name="Nav_Gaming" TabIndex="3" Content="GAMING &amp; GPU" Style="{StaticResource NavBtn}" Tag="&#xE7FC;" ToolTip="Optimize for frames and latency."/>
                                <Button x:Name="Nav_Handheld" TabIndex="4" Content="HANDHELD" Style="{StaticResource NavBtn}" Tag="&#xE76E;" ToolTip="ROG Ally / Legion Go / Claw Tools."/>
                                <Button x:Name="Nav_Privacy" TabIndex="5" Content="PRIVACY SHIELD" Style="{StaticResource NavBtn}" Tag="&#xE72E;" ToolTip="Block telemetry and data collection."/>
                                <Button x:Name="Nav_Declutter" TabIndex="6" Content="DECLUTTER" Style="{StaticResource NavBtn}" Tag="&#xE71C;" ToolTip="Ads, nags, Windows Update control, startup apps and quick tools."/>
                                <Button x:Name="Nav_Advanced" TabIndex="7" Content="ADVANCED TOOLS" Style="{StaticResource NavBtn}" Tag="&#xE90F;" ToolTip="Expert-level system tweaks."/>
                                <Button x:Name="Nav_Maint" TabIndex="8" Content="MAINTENANCE" Style="{StaticResource NavBtn}" Tag="&#xE9E9;" ToolTip="Repair and clean the system."/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="14,14,14,12">
                                <!-- RANK: hex badge + tier + C/B/A/S ladder. The engine sets Txt_HealthRank/HealthBar in the audit
                                     and asks the UI (mailbox 'RANK') to paint the badge, note and ladder. -->
                                <Border x:Name="RankCard" BorderBrush="#1B1F26" BorderThickness="1" CornerRadius="2" Padding="11,10,11,9" Margin="0,0,0,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#17FF2E3A" Offset="0"/><GradientStop Color="#E60B0D10" Offset="0.55"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid x:Name="Rank_Badge" Width="44" Height="50">
                                                <Grid.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Grid.Effect>
                                                <Path x:Name="Rank_Hex" Data="M22,0 L44,12.5 L44,37.5 L22,50 L0,37.5 L0,12.5 Z" Fill="#3A4048"/>
                                                <TextBlock x:Name="Txt_RankLetter" Text="?" FontFamily="{StaticResource Cond}" FontWeight="Bold" FontSize="28" Foreground="#12030A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="SYSTEM RANK" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692"/>
                                                <TextBlock x:Name="Txt_HealthRank" Text="CALIBRATING" FontFamily="{StaticResource Cond}" FontWeight="SemiBold" FontSize="18" Foreground="#F2F4F6" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="Txt_RankNote" Text="first audit running..." FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid Rows="1" Columns="4" Margin="0,9,0,0">
                                            <Border x:Name="Rank_C" Height="16" Margin="0,0,3,0" Background="#14FFFFFF"><TextBlock Text="C" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="#5C6570" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <Border x:Name="Rank_B" Height="16" Margin="0,0,3,0" Background="#14FFFFFF"><TextBlock Text="B" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="#5C6570" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <Border x:Name="Rank_A" Height="16" Margin="0,0,3,0" Background="#14FFFFFF"><TextBlock Text="A" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="#5C6570" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <Border x:Name="Rank_S" Height="16" Background="#14FFFFFF"><TextBlock Text="S" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="#5C6570" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </UniformGrid>
                                        <ProgressBar x:Name="HealthBar" Height="2" Background="#1B1F26" Foreground="#FF2E3A" BorderThickness="0" Value="0" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="GLOBAL CONFIG" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692" Margin="0,0,0,3"/>
                                <CheckBox x:Name="Global_TouchMode" Content="Touch Mode" FontSize="12" ToolTip="Enlarges UI elements for easier touch use."/>
                                <CheckBox x:Name="Global_SafeMode" Content="Auto-Backup" IsChecked="True" FontSize="12" ToolTip="Creates a Restore Point before applying tweaks."/>
                                <CheckBox x:Name="Global_ExpertMode" Content="Expert Mode" FontSize="12" Foreground="#E0A458" ToolTip="Unlocks dangerous tweaks.&#x0a;Use with caution."/>

                                <Button x:Name="Btn_Analyze" Content="RUN SYSTEM AUDIT" Height="34" Margin="0,12,0,4" Cursor="Hand" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F4F6" ToolTip="Re-scans the system state.">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="Bdr" Background="#0B0D11" BorderThickness="1">
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FF2E3A" Offset="0"/><GradientStop Color="#2A3038" Offset="0.7"/>
                                                        </LinearGradientBrush>
                                                    </Border.BorderBrush>
                                                </Border>
                                                <Path Data="M10,0 L10,10 L0,10 Z" Fill="#08090C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10" Stretch="Fill" Margin="0,0,-0.5,-0.5"/>
                                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                    <Path x:Name="Play" Data="M0,0 L9,5.5 L0,11 Z" Fill="#FF2E3A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="F5" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="#5C6570" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bdr" Property="Background" Value="#16080B"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <ProgressBar x:Name="ProgBar" Height="2" Margin="0,2,0,0" Background="Transparent" Foreground="#FF2E3A" BorderThickness="0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Border>

                <Grid Grid.Column="1" Background="Transparent" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- a faint red glow behind the header -->
                    <Ellipse Grid.Row="0" Width="640" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-190,0,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush><GradientStop Color="#1CFF2E3A" Offset="0"/><GradientStop Color="#00FF2E3A" Offset="1"/></RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid Width="864">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <!-- SHARED TAB HEADER (8.0 Black Ice). Update-TabHeader fills it on every tab change; the KPI
                                 tiles count the current tab's switches (on / queued / queued-that-need-a-reboot). -->
                            <Grid x:Name="Hdr" Grid.Row="0" Margin="26,6,26,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- zero-size canvas: the outlined word never takes part in layout and is never clipped -->
                                <Canvas Grid.ColumnSpan="2" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <Path x:Name="Hdr_Ghost" Canvas.Right="-4" Canvas.Top="-8" Stroke="#1CFFFFFF" StrokeThickness="1"/>
                                </Canvas>
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="/" FontFamily="{StaticResource Cond}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="36" Foreground="{StaticResource Accent}" Margin="0,0,11,0">
                                            <TextBlock.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock x:Name="Hdr_Title" Text="AUTO OPTIMIZE" FontFamily="{StaticResource Cond}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="36" Foreground="#F4F6F8"/>
                                        <Rectangle x:Name="Hdr_Cursor" Width="12" Height="27" Fill="{StaticResource Accent}" Margin="10,3,0,0" VerticalAlignment="Center">
                                            <Rectangle.Effect><DropShadowEffect Color="#FF2E3A" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/></Rectangle.Effect>
                                        </Rectangle>
                                    </StackPanel>
                                    <TextBlock x:Name="Hdr_Sub" Text="" FontSize="12.5" Foreground="#8A939E" Margin="1,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,2">
                                    <Button x:Name="Btn_Discard" Content="DISCARD" Style="{StaticResource GhostBtn}" Height="46" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Put this tab's switches back to how this PC is set right now. Nothing is changed on the PC."/>
                                    <Grid Width="86" Margin="0,0,8,0">
                                        <Border Background="#EB0B0D11" BorderBrush="#1B1F26" BorderThickness="1"/>
                                        <Rectangle x:Name="KpiBar_Active" Height="2" VerticalAlignment="Top" Fill="{StaticResource Accent}"/>
                                        <StackPanel Margin="10,7,8,5">
                                            <TextBlock Text="ACTIVE" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="Kpi_Active" Text="--" Style="{StaticResource KpiValue}" Foreground="#F4F6F8"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Width="86" Margin="0,0,8,0">
                                        <Border Background="#EB0B0D11" BorderBrush="#1B1F26" BorderThickness="1"/>
                                        <Rectangle x:Name="KpiBar_Queued" Height="2" VerticalAlignment="Top" Fill="#2E343C"/>
                                        <StackPanel Margin="10,7,8,5">
                                            <TextBlock Text="QUEUED" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="Kpi_Queued" Text="0" Style="{StaticResource KpiValue}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Width="86">
                                        <Border Background="#EB0B0D11" BorderBrush="#1B1F26" BorderThickness="1"/>
                                        <Rectangle x:Name="KpiBar_Reboot" Height="2" VerticalAlignment="Top" Fill="#2E343C"/>
                                        <StackPanel Margin="10,7,8,5">
                                            <TextBlock Text="REBOOT" Style="{StaticResource KpiLabel}"/>
                                            <TextBlock x:Name="Kpi_Reboot" Text="0" Style="{StaticResource KpiValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectedIndex="0" Margin="26,10,26,6">
                                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                                <TabItem x:Name="Tab_Auto">
                                    <StackPanel>
                                        <Border Background="#990A0A0A" Padding="25" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                             
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                                                    <ContentControl Content="PERFORMANCE" Style="{StaticResource H1}" Margin="0,0,0,5"/>
                                                    <CheckBox x:Name="Auto_Visuals" Content="Apply 'Ronin' Visuals" IsChecked="True" ToolTip="Adjusts Windows animations for speed."/>
                                                    <CheckBox x:Name="Auto_SysRestore" Content="Disable System Restore" ToolTip="Saves space/cycles, but WARNING: this also disables Ronin's own Auto-Backup restore points. Leave unchecked unless storage is critical."/>
                                                    <CheckBox x:Name="Auto_Remote" Content="Disable Remote Assistance" IsChecked="True" ToolTip="Security hardening against remote access."/>
                                                    <CheckBox x:Name="Auto_Drivers" Content="Block Driver Auto-Install" IsChecked="True" ToolTip="Prevents Windows from silently pushing driver updates via Windows Update."/>
                                                    <CheckBox x:Name="Auto_Recall" Content="Disable Windows Recall" IsChecked="True" ToolTip="Disables AI screenshotting features."/>
                                                    <CheckBox x:Name="Auto_UAC" Content="Set UAC to 'Never Notify'" IsChecked="True" ToolTip="Reduces system interruptions."/>
                                                    <CheckBox x:Name="Auto_Hags" Content="Enable HAGS (GPU Sched)" IsChecked="True" ToolTip="Hardware Accelerated GPU Scheduling."/>
                                                    <CheckBox x:Name="Auto_GameMode" Content="Force 'Game Mode' On" IsChecked="True" ToolTip="Prioritizes games over background processes."/>
                                                    <CheckBox x:Name="Auto_CoreIso" Content="Disable Memory Integrity" IsChecked="True" ToolTip="Disables VBS/HVCI for better gaming FPS."/>
                                                    <CheckBox x:Name="Auto_Bright" Content="Disable Auto-Brightness" IsChecked="True" ToolTip="Stops screen dimming on battery."/>
                                                    <CheckBox x:Name="Auto_CpuOpt" Content="Smart CPU Efficiency" IsChecked="True" ToolTip="Optimizes processor power management."/>
                                                    <CheckBox x:Name="Auto_StartAds" Content="Disable System-Wide Ads" IsChecked="True" ToolTip="Blocks ads in Start, Lock Screen, Settings, and Explorer."/>
                                                    
                                                    <ContentControl Content="HARDWARE" Style="{StaticResource H1}" Margin="0,15,0,5"/>
                                                    <CheckBox x:Name="Auto_PCIe" Content="Disable PCIe Power Saving" IsChecked="True" ToolTip="CRITICAL: Forces L0 state to fix gaming micro-stutters."/>
                                                    <CheckBox x:Name="Auto_VariBright" Content="Disable AMD Vari-Bright" IsChecked="True" ToolTip="Fixes washed out colors on battery (AMD Only)."/>
                                                    <CheckBox x:Name="Auto_DPST" Content="Disable Intel DPST" IsChecked="True" Visibility="Collapsed" ToolTip="Fixes washed out colors/brightness on battery (Intel Only)."/>
                                                </StackPanel>
                                              
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
                                                    <ContentControl Content="PRIVACY" Style="{StaticResource H1}" Margin="0,0,0,5" Foreground="#66c0f4"/>
                                                    <CheckBox x:Name="Auto_Tele" Content="Disable Telemetry &amp; Data" IsChecked="True" ToolTip="Blocks basic Windows diagnostic data."/>
                                                    <CheckBox x:Name="Auto_Activity" Content="Disable Activity History" IsChecked="True" ToolTip="Stops Timeline activity tracking."/>
