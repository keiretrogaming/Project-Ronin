                            <!-- 8.0: icon | message (wraps) | buttons. A horizontal StackPanel pushed the buttons off-screen at the 800 px MinWidth (banners are outside the scaling Viewbox). -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="#FFCF5C" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ResetBannerText" Text="A Windows update undid some of your tweaks." Foreground="#FFE7A8" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button x:Name="Btn_ResetReapply" Content="RE-APPLY" Padding="10,2" Background="#4A3A00" Foreground="White" BorderBrush="#FFCF5C" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="Put these tweaks back on now."/>
                                    <Button x:Name="Btn_ResetShow" Content="SHOW ME" Margin="6,0,0,0" Padding="10,2" Background="Transparent" Foreground="#FFE7A8" BorderBrush="#7A6420" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="List them in the console and open the changes list in Maintenance."/>
                                    <Button x:Name="Btn_ResetKeep" Content="KEEP IT MY WAY" Margin="6,0,0,0" Padding="10,2" Background="Transparent" Foreground="#FFE7A8" BorderBrush="#7A6420" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="Leave them off. Ronin forgets it applied them and won't mention them again."/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 8.0: "Turn Updates Off" reminder - shown at startup once updates have been off for
                             30 days (Test-UpdatesReminderDue). Nothing changes until a button is clicked. -->
                        <Grid x:Name="Banner_Updates" Background="#331A00" MinHeight="34" Visibility="Collapsed">
                            <!-- 8.0: icon | message (wraps) | buttons. A horizontal StackPanel pushed the buttons off-screen at the 800 px MinWidth (banners are outside the scaling Viewbox). -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB060" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="UpdatesBannerText" Text="Windows updates have been off for a while." Foreground="#FFD9B0" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button x:Name="Btn_UpdatesOn" Content="TURN BACK ON" Padding="10,2" Background="#4A2A00" Foreground="White" BorderBrush="#FFB060" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="Resume Windows Update now (reverts Turn Updates Off)."/>
                                    <Button x:Name="Btn_UpdatesSnooze" Content="REMIND ME IN 30 DAYS" Margin="6,0,0,0" Padding="10,2" Background="Transparent" Foreground="#FFD9B0" BorderBrush="#7A5020" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="Keep updates off and ask again in 30 days."/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 7.6: "Ask me first" Explorer setting. The engine never prompts (no modals from the
                             engine), so a finished batch shows this instead of restarting Explorer itself. -->
                        <Grid x:Name="Banner_Explorer" Background="#1C2433" MinHeight="32" Visibility="Collapsed">
                            <!-- 8.0: icon | message (wraps) | buttons. A horizontal StackPanel pushed the buttons off-screen at the 800 px MinWidth (banners are outside the scaling Viewbox). -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="#9CC4FF" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="Restart Explorer to finish your taskbar, Start and Explorer changes." Foreground="#D6E6FF" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button x:Name="Btn_ExplorerNow" Content="RESTART EXPLORER" Padding="10,2" Background="#2A3A55" Foreground="White" BorderBrush="#9CC4FF" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="The taskbar and open folders blink for a second."/>
                                    <Button x:Name="Btn_ExplorerLater" Content="LATER" Margin="6,0,0,0" Padding="10,2" Background="Transparent" Foreground="#D6E6FF" BorderBrush="#3A4A66" BorderThickness="1" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Cursor="Hand" ToolTip="The change shows after you next sign in."/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#14181D" BorderThickness="0,1,0,0" Padding="26,7,22,7" Background="#EB06070A">
                        <!-- 8.0 Black Ice info panel: "INFO DOJO // label" and the registry value it writes on one line,
                             then up to 3 lines of description ('...' past that; the hover tooltip has it all). -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" Padding="12,1,10,1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#17FF2E3A" Offset="0"/><GradientStop Color="#00FF2E3A" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="INFO DOJO" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Grid.Column="1" Text=" // " FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="#5C6570"/>
                                        <TextBlock x:Name="Txt_DojoTitle" Grid.Column="2" Text="HOVER A TWEAK" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="#E6EAEE" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="Txt_DojoReg" Grid.Column="3" Text="" MaxWidth="420" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="#8FB8DE" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="InfoDojo" Text="Hover over any tweak to learn more..." FontSize="12" LineHeight="14.5" LineStackingStrategy="BlockLineHeight" Foreground="#7D8692" TextWrapping="Wrap" TextTrimming="WordEllipsis" Height="44" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Border Width="16" Height="8" BorderBrush="#FF2E3A" BorderThickness="1" Background="{StaticResource OnFill}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ON" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Border Width="16" Height="8" BorderBrush="#F2A93B" BorderThickness="1" Background="{StaticResource HazardAmber}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="QUEUED" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="8" BorderBrush="#2E343C" BorderThickness="1" Background="#090B0E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="OFF" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="#7D8692"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 8.0 ENGINE LOG drawer: the full console, opened from the status bar's LOG button (Esc or X closes). -->
            <Border x:Name="LogPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" Height="240" Margin="236,0,0,0" Background="#FA040507" BorderBrush="#FF2E3A" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="16,4,4,2">
                        <TextBlock Text="ENGINE LOG" FontFamily="{StaticResource Mono}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <Button x:Name="Btn_LogClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource WindowControlBtn}" Height="24" Width="32" HorizontalAlignment="Right" ToolTip="Close the log (Esc)"/>
                    </Grid>
                    <ScrollViewer x:Name="ConsoleScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,10,10">
                        <TextBlock x:Name="ConsoleOutput" Text="&gt; RONIN ENGINE ONLINE..." Foreground="#7FD9A0" FontFamily="{StaticResource Mono}" FontSize="11" LineHeight="16" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- 7.6 SETTINGS: slide-over panel. Last child of the root grid's content row, so it draws over
                 the nav and tabs but not the title bar (the gear stays clickable to close it). A panel,
                 not a window: it can never open behind Ronin, and nothing here is modal. -->
            <Grid x:Name="SettingsOverlay" Grid.Row="1" Visibility="Collapsed">
                <Border x:Name="SettingsScrim" Background="#99000000" CornerRadius="0,0,8,8"/>
                <Border x:Name="SettingsPanel" HorizontalAlignment="Right" Width="380" Background="#121212" BorderBrush="#FF2E3A" BorderThickness="1,0,0,0" CornerRadius="0,0,8,0">
                    <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="20,14,8,6">
                            <ContentControl Content="SETTINGS" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center"/>
                            <Button x:Name="Btn_SettingsClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WindowControlBtn}" HorizontalAlignment="Right" ToolTip="Close settings (Esc)"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,4,20,20">

                                <ContentControl Content="STARTUP" Style="{StaticResource H1}" FontSize="12" Margin="0,10,0,8"/>
                                <TextBlock Text="Open Ronin on" Foreground="#CCC" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>
                                <ComboBox x:Name="Set_StartTab" Height="34" Style="{StaticResource DarkComboStyle}" FontSize="12">
                                    <ComboBoxItem Tag="smart" Content="Handheld on handhelds, otherwise Auto Optimize"/>
                                    <ComboBoxItem Tag="last" Content="The tab I used last"/>
                                    <ComboBoxItem Tag="Tab_Auto" Content="Auto Optimize"/>
                                    <ComboBoxItem Tag="Tab_System" Content="System Core"/>
                                    <ComboBoxItem Tag="Tab_Gaming" Content="Gaming &amp; GPU"/>
                                    <ComboBoxItem Tag="Tab_Handheld" Content="Handheld"/>
                                    <ComboBoxItem Tag="Tab_Privacy" Content="Privacy Shield"/>
                                    <ComboBoxItem Tag="Tab_Declutter" Content="Declutter"/>
                                    <ComboBoxItem Tag="Tab_Advanced" Content="Advanced Tools"/>
                                    <ComboBoxItem Tag="Tab_Maint" Content="Maintenance"/>
                                </ComboBox>
                                <CheckBox x:Name="Set_ResetAlert" Content="Warn me if Windows undoes tweaks" ToolTip="After a Windows update or another app turns off tweaks Ronin applied, show a banner offering to re-apply them." Margin="0,12,0,0"/>

                                <ContentControl Content="SAFETY" Style="{StaticResource H1}" FontSize="12" Margin="0,22,0,8"/>
                                <CheckBox x:Name="Set_Preview" Content="Preview changes before applying"/>
                                <TextBlock Text="Apply asks for a second click and lists what will change in the console." Foreground="#777" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="26,2,0,12"/>
                                <TextBlock Text="After Gallery or Home changes, restart Explorer" Foreground="#CCC" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <ComboBox x:Name="Set_ExplorerRestart" Height="34" Style="{StaticResource DarkComboStyle}" FontSize="12">
                                    <ComboBoxItem Tag="auto" Content="Automatically"/>
                                    <ComboBoxItem Tag="ask" Content="Only when I click a button"/>
                                </ComboBox>

                                <ContentControl Content="DIAGNOSTICS" Style="{StaticResource H1}" FontSize="12" Margin="0,22,0,8"/>
                                <Button x:Name="Btn_SetBugReport" Content="SAVE BUG REPORT" Background="#252526" Foreground="#7FD0FF" Height="36" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <Button x:Name="Btn_SetOpenLogs" Content="OPEN LOGS FOLDER" Background="#252526" Foreground="White" Height="36" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <Button x:Name="Btn_SetReset" Content="RESET RONIN'S SETTINGS" Background="#252526" Foreground="#FF9999" Height="36" FontFamily="Consolas"/>
                                <TextBlock Text="Resets these preferences only. Your tweaks are not changed." Foreground="#777" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Text="Expert Mode, Touch Mode and Auto-Backup keep their setting between launches." Foreground="#888" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,22,0,0"/>
                                <TextBlock x:Name="Txt_SettingsPath" Text="" Foreground="#555" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 8.0 STATUS BAR: the console's newest line (the caret blinks while the engine works), the open tab,
                 live CPU / RAM and the Windows build. LOG opens the full console. -->
            <Grid x:Name="StatusBar" Grid.Row="2" Background="#F2040507">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="4" Height="1" VerticalAlignment="Top" Fill="#14181D"/>
                <Grid Grid.Column="0" Panel.ZIndex="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="0,0,0,7"/>
                    <Path Grid.Column="1" Stretch="Fill" Fill="{StaticResource Accent}" Data="M0,0 L10,13 L0,26 Z"/>
                    <TextBlock Text="RONIN" FontFamily="{StaticResource Mono}" FontSize="10.5" FontWeight="Bold" Foreground="#12030A" VerticalAlignment="Center" Margin="12,0,8,0"/>
                </Grid>
                <Grid Grid.Column="1" Margin="-10,0,0,0" Panel.ZIndex="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1A1E24"/>
                    <Path Grid.Column="1" Stretch="Fill" Fill="#1A1E24" Data="M0,0 L10,13 L0,26 Z"/>
                    <TextBlock x:Name="Txt_StatusTab" Text="~/auto" Style="{StaticResource StatusText}" Foreground="#C9D0D7" Margin="20,0,6,0"/>
                </Grid>
                <TextBlock x:Name="Status_Msg" Grid.Column="2" Margin="12,0,12,0" Style="{StaticResource StatusText}" TextTrimming="CharacterEllipsis" Cursor="Hand" ToolTip="Click to show the full log"><Run x:Name="Txt_ConsoleLast" Text="ronin engine online" Foreground="#7FD9A0"/><InlineUIContainer BaselineAlignment="Center"><Rectangle x:Name="Status_Caret" Width="7" Height="12" Fill="#7FD9A0" Margin="7,0,0,0"/></InlineUIContainer></TextBlock>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="CPU " Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="Txt_CpuStatus" Text="..." Style="{StaticResource StatusText}" Foreground="#C9D0D7" MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                    <TextBlock Text="RAM " Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="Txt_RamStatus" Text="..." Style="{StaticResource StatusText}" Foreground="#C9D0D7" Margin="0,0,7,0"/>
                    <Grid Width="40" Height="4" VerticalAlignment="Center" Margin="0,0,14,0" Background="#1A1E24">
                        <Rectangle x:Name="Bar_Ram" Width="0" HorizontalAlignment="Left" Fill="#C9D0D7"/>
                    </Grid>
                    <TextBlock Text="BUILD " Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="Txt_Build" Text="" Style="{StaticResource StatusText}" Foreground="#C9D0D7" Margin="0,0,12,0"/>
                    <Button x:Name="Btn_Log" Content="&#x25B4; LOG" Style="{StaticResource GhostBtn}" Height="18" FontSize="9.5" Padding="8,0" ToolTip="Show the full engine log"/>
                </StackPanel>
            </Grid>

            <!-- 8.0 CRT finish: faint scanlines + vignette over everything. Never hit-testable, never animated. -->
            <Rectangle x:Name="Fx_Scanlines" Grid.RowSpan="3" IsHitTestVisible="False" RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3"/></GeometryDrawing.Geometry></GeometryDrawing>
                                <GeometryDrawing Brush="#08FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry></GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="Fx_Vignette" Grid.RowSpan="3" IsHitTestVisible="False" RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.72">
                        <GradientStop Color="#00000000" Offset="0.7"/><GradientStop Color="#55000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Border>
</Window>