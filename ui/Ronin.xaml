                                                        <TextBlock Text="DISM RestoreHealth + SFC + CHKDSK scan" Foreground="#777" FontSize="10" Margin="0,0,0,10"/>
                                                        <Button x:Name="Btn_SFC" Content="RUN SFC SCANNOW" Style="{StaticResource MBtn}" ToolTip="Scans for and fixes corrupt system files."/>
                                                        <Button x:Name="Btn_DISM" Content="RUN DISM RESTOREHEALTH" Style="{StaticResource MBtn}" ToolTip="Repairs the Windows System Image."/>
                                                        <Button x:Name="Btn_NetReset" Content="FLUSH DNS &amp; RESET NETWORK" Style="{StaticResource MBtn}" ToolTip="Resets winsock and flushes DNS cache."/>
                                                        <Button x:Name="Btn_WuReset" Content="RESET WINDOWS UPDATE" Style="{StaticResource MBtn}" Background="#522" ToolTip="Fixes stuck Windows Updates."/>
                                                        <Button x:Name="Btn_StoreReset" Content="RESET MICROSOFT STORE" Style="{StaticResource MBtn}" ToolTip="Re-registers the Windows Store manifest to fix download errors."/>
